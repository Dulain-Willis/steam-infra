# Copy to .env (gitignored) and fill in. See README for the one-time
# Snowflake setup (RSA key pair registered on the user) these values assume.

# Snowflake account identifier, e.g. FMBSGSW-YU41950 (from the account URL).
# The combined <ORG>-<ACCOUNT> form, which the Python connector, the Kafka
# sink and dbt all want.
SNOWFLAKE_ACCOUNT=

# The same identifier split in two, which the snowflakedb/snowflake OpenTofu
# provider wants instead (terraform/snowflake). Both must agree: preflight
# fails if SNOWFLAKE_ACCOUNT isn't "<ORG>-<ACCOUNT>". Get them from
# `select current_organization_name(), current_account_name()` — note that is
# NOT current_account(), which returns the account *locator*.
SNOWFLAKE_ORGANIZATION_NAME=
SNOWFLAKE_ACCOUNT_NAME=

# Snowflake user the connector, Airflow, and these scripts connect as.
SNOWFLAKE_USER=

# Path to that user's RSA private key (PEM, PKCS8, unencrypted). Kept
# outside the repo; never commit a real key.
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/snowflake_key.p8

# Where Airflow sends DAG failure/SLA alerts.
AIRFLOW_ALERT_EMAIL=
